#include <nusys.h>

beginseg
	name	"program"
	flags	BOOT OBJECT
	entry 	nuBoot
	address NU_SPEC_BOOT_ADDR
	stack   NU_SPEC_BOOT_STACK

	include "build/audio-codesegment.o"
	include "$(ROOT)/usr/lib/PR/rspboot.o"
	include "$(ROOT)/usr/lib/PR/aspMain.o"
	include "$(ROOT)/usr/lib/PR/gspF3DEX2.fifo.o"
	include "$(ROOT)/usr/lib/PR/gspL3DEX2.fifo.o"
	include "$(ROOT)/usr/lib/PR/gspF3DEX2.Rej.fifo.o"
	include "$(ROOT)/usr/lib/PR/gspF3DEX2.NoN.fifo.o"
	include "$(ROOT)/usr/lib/PR/gspF3DLX2.Rej.fifo.o"
	include "$(ROOT)/usr/lib/PR/gspS2DEX2.fifo.o"
endseg

beginseg
	name "musicTitle"
	flags RAW
	include "assets/audio/music-title.vadpcm.bin"
endseg

beginseg
	name "musicGame"
	flags RAW
	include "assets/audio/music-game.vadpcm.bin"
endseg

beginseg
	name "sfxPickup"
	flags RAW
	include "assets/audio/sfx/pickup.pcm.bin"
endseg

beginseg
	name "sfxPunch"
	flags RAW
	include "assets/audio/sfx/punch.pcm.bin"
endseg

beginseg
	name "sfxBreak"
	flags RAW
	include "assets/audio/sfx/break.pcm.bin"
endseg

beginseg
	name "sfxPlace"
	flags RAW
	include "assets/audio/sfx/place.pcm.bin"
endseg

beginwave
	name	"mine64-audio"
	include	"program"
	include	"musicTitle"
	include	"musicGame"
	include	"sfxPickup"
	include	"sfxPunch"
	include	"sfxBreak"
	include	"sfxPlace"
endwave
