#!/usr/bin/env bash
# Build Mine64 in the project SDK container and save it to SummerCart64's SD card.
set -euo pipefail

PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BUILD_IMAGE="${MINE64_BUILD_IMAGE:-mine64-nusys-build:local}"
DOCKER_PLATFORM="${MINE64_DOCKER_PLATFORM:-linux/amd64}"
SC64_DEPLOYER="${SC64_DEPLOYER:-$PROJECT_DIR/../N64FlashcartMenu/tools/sc64/sc64deployer}"
SC64_SD_PATH="${SC64_SD_PATH:-/Games/Mine64.n64}"

if ! command -v docker >/dev/null; then
    echo "Docker is required to build Mine64." >&2
    exit 1
fi

if [[ ! -x "$SC64_DEPLOYER" ]]; then
    echo "SummerCart64 deployer was not found: $SC64_DEPLOYER" >&2
    echo "Set SC64_DEPLOYER to its full path and retry." >&2
    exit 1
fi

echo "Checking the SummerCart64 SD card..."
require_sd_access() {
    SC64_INFO="$("$SC64_DEPLOYER" info)"
    if ! grep -Fq "SD card status:    Initialized" <<<"$SC64_INFO"; then
        echo "The SummerCart64 SD card is not initialized." >&2
        printf '%s\n' "$SC64_INFO" >&2
        exit 1
    fi

    if ! grep -Fq "Current CIC step:  Power off" <<<"$SC64_INFO"; then
        echo "The N64 is still using the SummerCart64 SD card." >&2
        echo "Turn the N64 off, wait for it to power down, then run ./perma-load again." >&2
        exit 1
    fi
}

require_sd_access

echo "Building Mine64..."
docker run --rm --platform "$DOCKER_PLATFORM" \
    -v "$PROJECT_DIR:/work" -w /work \
    "$BUILD_IMAGE" make -j2

# The console may have been powered on while the ROM was building, so check
# immediately before claiming the SD card for the USB upload.
require_sd_access

echo "Saving build/mine64.n64 to $SC64_SD_PATH..."
"$SC64_DEPLOYER" sd upload "$PROJECT_DIR/build/mine64.n64" "$SC64_SD_PATH"
"$SC64_DEPLOYER" sd stat "$SC64_SD_PATH"

# Symbols matching exactly this deployed ROM, for resolving the addresses in
# a freeze post-mortem (mine64/freeze.txt).  See tools/resolve_freeze.sh.
cp "$PROJECT_DIR/mine64.out" "$PROJECT_DIR/build/mine64-deployed.out"
echo "Symbols archived to build/mine64-deployed.out"

cat <<EOF

Saved successfully. Turn the N64 on to boot the SummerCart64 SD menu, then
select $SC64_SD_PATH.
EOF
